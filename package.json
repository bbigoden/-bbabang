    "inspect:visual:full": "cross-env FULL=1 playwright test --config=playwright.config.ts",
    "inspect:visual:report": "playwright show-report test-results/visual-report",
    "inspect:e2e": "playwright test --config=playwright.e2e.config.ts --reporter=list",
    "backup:db": "node scripts/db-backup.mjs",
    "push:test": "node scripts/push-test.mjs",
    "perf:web": "node scripts/perf-web-vitals.mjs",

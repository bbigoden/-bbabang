    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node integration-test.mjs",
    "test:a11y": "node accessibility-test.mjs",

# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사 금지
SUPABASE_SERVICE_ROLE_KEY=
# DB 직접 접속 URI (점검 21단계 백업 스크립트 npm run backup:db 전용, 로컬만)
# Supabase 대시보드 > Settings > Database > Connection string (URI) — 비밀번호 포함
SUPABASE_DB_URL=

# ============================================================
# Kakao
# ============================================================
# 클라이언트 노출 — JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_KEY=
# 서버 전용 — REST API 키 (주소→좌표, 지역 검색)
KAKAO_REST_KEY=

# ============================================================
# 외부 API (서버 전용)
# ============================================================
# 세움터 (건축물대장 공공 API) — https://www.data.go.kr/data/15044713/openapi.do
SEUM_API_KEY=
# 공공데이터 (사업자 등록번호 진위 확인)
PUBLICDATA_API_KEY=
# Google Gemini (관리자 '쇼츠 공장' 대본 생성) — https://aistudio.google.com/apikey
# 미설정 시 데모 대본으로 동작. 무료 한도 내에서 운영 가능.
GEMINI_API_KEY=
# ElevenLabs (관리자 '쇼츠 공장' AI 더빙 음성 생성) — https://elevenlabs.io/app/settings/api-keys
# 미설정 시 음성 생성 기능만 비활성화. 무료 티어 월 10,000자.
ELEVENLABS_API_KEY=
# 보이스 ID 선택 (선택사항, 미설정 시 Adam 기본값 사용)
# Adam(남·진지): pNInz6obpgDQGcFmaJgB / Bella(여·부드러움): EXAVITQu4vr4xnSDxMaL
# Rachel(여·차분): 21m00Tcm4TlvDq8ikWAM / Antoni(남·친근): ErXwobaYiN019PkySvjV
ELEVENLABS_VOICE_ID=
# Pexels (관리자 '쇼츠 공장' 자료화면 자동 검색) — https://www.pexels.com/api/
# 미설정 시 영상 자동 합성 기능만 비활성화. 무료 (월 200회/시간당 20회).
PEXELS_API_KEY=
# Creatomate (관리자 '쇼츠 공장' 서버측 영상 합성) — https://creatomate.com
# 미설정 시 영상 합성 기능만 비활성화. Free Tier 월 50 크레딧 (영상 50개).
CREATOMATE_API_KEY=

# ============================================================
# 이메일 (Resend)
# ============================================================
RESEND_API_KEY=
EMAIL_FROM=부소장 <noreply@bbabang.app>
# 에러 자동 알림 수신처
ALERT_EMAIL_TO=bbigoden@gmail.com

# ============================================================
# 웹 푸시 (VAPID)
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bbigoden@gmail.com

# ============================================================
# Cron 인증 — Vercel Cron Jobs용
# ============================================================
# 이 값이 프로덕션에 없으면 /api/cron/* 이 전부 401로 거부돼 자동화가
# 통째로 멈춘다(알림·만료 처리·리마인더). Vercel은 이 변수가 있으면
# cron 호출에 Authorization: Bearer <값>을 자동으로 붙인다.
# 등록: npx vercel env add CRON_SECRET production → 재배포해야 적용됨
CRON_SECRET=

# ============================================================
# 점검 스크립트 전용 (로컬)
# ============================================================
# npm run perf:web 대상 (미설정 시 프로덕션 URL)
PERF_BASE_URL=
# 점검 계정(t1/t2/admin) 공용 비밀번호 — push:test, inspect:visual, inspect:e2e, e2e-test.mjs 모두 사용
# 공개 레포이므로 테스트 코드에 비밀번호를 하드코딩하지 말 것 (2026-07-30 노출 사고 후 env로 이관)
PUSH_TEST_PASSWORD=
# 절대 URL 생성 기준 (알림 링크 등). 미설정 시 프로덕션 URL 폴백
NEXT_PUBLIC_APP_URL=

# ============================================================
# Footer 사업자정보 (운영 환경에서 설정)
# ============================================================
# NEXT_PUBLIC_BUSINESS_NAME=부소장
# NEXT_PUBLIC_BUSINESS_CEO=대표자명
# NEXT_PUBLIC_BUSINESS_REG_NUMBER=000-00-00000
# NEXT_PUBLIC_OFFICE_REG_NUMBER=제0000-00000호
# NEXT_PUBLIC_BUSINESS_ADDRESS=서울시 ...
# NEXT_PUBLIC_BUSINESS_PHONE=02-0000-0000
# NEXT_PUBLIC_CONTACT_EMAIL=bbigoden@gmail.com

# 국토부 VWorld 부동산중개업 조회 (사무소 자동 인증) — 발급 도메인 바인딩 주의
VWORLD_API_KEY=
